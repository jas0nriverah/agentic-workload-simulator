  "features": [
    {"name": "prompt_tokens", "type": "integer", "unit": "tokens", "formula": "declared input token target", "source": "frozen request manifest", "available_before_request": true, "allowed_for_fit": true},
    {"name": "max_output_tokens", "type": "integer", "unit": "tokens", "formula": "declared maximum output token budget (not actual completion length)", "source": "frozen request manifest", "available_before_request": true, "allowed_for_fit": true},
    {"name": "context_tokens", "type": "integer", "unit": "tokens", "formula": "declared pre-request context size; zero when not separately specified", "source": "frozen request manifest", "available_before_request": true, "allowed_for_fit": true},
    {"name": "tool_calls", "type": "integer", "unit": "calls", "formula": "declared tool-call count before execution", "source": "frozen request manifest", "available_before_request": true, "allowed_for_fit": true},
    {"name": "hardware_score", "type": "number", "unit": "relative", "formula": "predeclared hardware normalization; 1.0 for the calibration H100", "source": "frozen protocol", "available_before_request": true, "allowed_for_fit": true},
    {"name": "prompt_output_interaction", "type": "number", "unit": "token-million-per-hardware", "formula": "prompt_tokens / 1000 * max_output_tokens / 1000 / hardware_score", "source": "derived from pre-request feature manifest", "available_before_request": true, "allowed_for_fit": true},
    {"name": "concurrency", "type": "integer", "unit": "requests", "formula": "request_protocol.concurrency", "source": "frozen protocol", "available_before_request": true, "allowed_for_fit": true, "constant": 1},
    {"name": "warm_state", "type": "categorical", "unit": "label", "formula": "measured rows follow warmup_requests", "source": "frozen protocol", "available_before_request": true, "allowed_for_fit": true, "constant": "warm"},
    {"name": "holdout_kind", "type": "categorical", "unit": "label", "formula": "calibration or interpolation/extrapolation split annotation", "source": "sealed split manifest", "available_before_request": true, "allowed_for_fit": false, "evaluation_only": true}
  ],
  "labels": [
    {"name": "wall_ms", "unit": "milliseconds", "definition": "request end minus request start on CLOCK_MONOTONIC_RAW", "provenance": "measured", "primary": true},
    {"name": "cpu_activity_union_ms", "unit": "milliseconds", "definition": "union of traced CPU operation intervals after the declared overlap rule", "provenance": "measured", "primary": false},
    {"name": "cuda_activity_union_ms", "unit": "milliseconds", "definition": "overlap-aware union of CUDA activity intervals within the request window", "provenance": "measured", "primary": false},
    {"name": "kernel_duration_sum_ms", "unit": "milliseconds", "definition": "sum of kernel durations retained as diagnostic only; not elapsed device time", "provenance": "measured", "primary": false},
    {"name": "actual_prompt_tokens", "unit": "tokens", "definition": "usage.prompt_tokens from the response", "provenance": "measured", "primary": false},
    {"name": "actual_completion_tokens", "unit": "tokens", "definition": "usage.completion_tokens from the response", "provenance": "measured", "primary": false}
  ],
  "fit_specification": {
    "model_id": "h100_feature_latency_v1",
    "response": "wall_ms",
    "fit_rows": "calibration only, aggregate each case by median of successful repetitions",
    "feature_names": ["prompt_tokens", "max_output_tokens", "context_tokens", "tool_calls", "hardware_score", "prompt_output_interaction"],
    "constant_features": ["concurrency", "warm_state"],
    "model_family": "regularized_nonnegative_additive_with_interaction",
    "selection": "fixed formula and regularization chosen before the split hash is sealed; no holdout-driven tuning",
    "prediction_artifact_required_before_holdout_join": true
  },
  "scoring": {
    "primary_metric": "case_median_wall_mape_percent",
    "secondary_metrics": ["case_median_wall_mae_ms", "case_median_wall_rmse_ms", "repeat_level_wall_mape_percent", "interpolation_wall_mape_percent", "extrapolation_wall_mape_percent", "p95_absolute_percentage_error", "coverage_percent"],
    "aggregation": "median successful repeats per case; report every repeat and case denominator",
    "mape_zero_policy": "exclude zero measured labels and report exclusion; zero labels are invalid for this protocol",
    "acceptance_thresholds": {"coverage_percent": 100.0, "primary_wall_mape_percent_max": 25.0, "interpolation_wall_mape_percent_max": 25.0, "extrapolation_wall_mape_percent_max": 35.0},
    "failure_policy": "failed, contaminated, missing-clock, or non-200 rows remain explicit unavailable rows and do not silently leave the denominator"
  },
  "leakage_boundaries": {
    "seal_before_run": true,
    "split_manifest_hash_required": true,
    "calibration_ids": "only calibration_configs.case_id",
    "holdout_ids": "only sealed_holdouts.case_id",
    "holdout_raw_access": "forbidden to fitting process; reveal only after predictions and prediction hash are persisted",
    "forbidden_fit_inputs": ["holdout wall_ms", "holdout CPU/CUDA labels", "holdout response body", "holdout actual token counts", "any post-fit target label", "case-specific manual parameter changes", "repeat outcome or success status as a feature"],
    "required_assertions": ["all case IDs are unique", "calibration and holdout IDs are disjoint", "predictions reference the sealed split hash", "prediction artifact mtime precedes holdout-label join", "fit input hash excludes holdout paths", "raw artifacts are immutable and checksummed"],
    "reveal_receipt": "write a timestamped holdout_reveal_receipt.json only after prediction_manifest.json is immutable"
  },
  "artifact_layout": {
