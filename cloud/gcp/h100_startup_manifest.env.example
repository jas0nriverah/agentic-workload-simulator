# Copy this file outside the checkout, set REQUIRED_COMMIT after the release
# is pushed, and pass it to scripts/cloud/start_h100.sh.  This file contains
# no credentials and must never be sourced as a shell script.
REQUIRED_BRANCH=parallel-h100-shards
REQUIRED_COMMIT=<40-hex-pushed-commit>
PROTOCOL_SHA256=3fb870a4a619afe9cdc697c6f8edcee51c4814ff01ebd552a904f0c9a9271eac
PYTHON_LOCK_SHA256=7e1177bf4c0b4efe4d64895f39b340413336b77e02d2f72bbf5aad387accc9cc
SYSTEM_LOCK_SHA256=a2507fbf3cb360091c9657ff1a000a975521d8aa360cf6e3f18a3318fb15f1e5

# Host-local paths.  Keep the model cache and startup trace root outside the
# repository and outside artifacts/h100_final_validation/.
WORK_ROOT=/mnt/eic-work
PYTHON_ENV_ROOT=/mnt/eic-work/venv
PYTHON_BOOTSTRAP_BIN=python3.11
MODEL_CACHE=/mnt/eic-work/cache/huggingface
MODEL_SNAPSHOT=/mnt/eic-work/cache/huggingface/hub/models--Qwen--Qwen3-Coder-30B-A3B-Instruct/snapshots/b2cff646eb4bb1d68355c01b18ae02e7cf42d120
TRACE_ROOT=/mnt/eic-work/h100-startup-traces

# These values must remain exactly equal to the sealed protocol and launcher.
# BACKEND may be auto, docker, or direct.  auto probes Docker/NVIDIA GPU
# access and selects direct only when that probe fails; explicit docker fails
# closed and never falls back.  This file is never sourced as shell code.
BACKEND=auto
VLLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
VLLM_MODEL_REVISION=b2cff646eb4bb1d68355c01b18ae02e7cf42d120
VLLM_IMAGE=vllm/vllm-openai:v0.10.0@sha256:05a31dc4185b042e91f4d2183689ac8a87bd845713d5c3f987563c5899878271
VLLM_IMAGE_PLATFORM=linux/amd64
VLLM_TOOL_PARSER=qwen3_coder
VLLM_MAX_MODEL_LEN=32768
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PORT=8000
VLLM_GPU_MEMORY_UTILIZATION=0.90
H100_CONTAINER=h100-final-vllm
H100_NSYS_SESSION=h100-final-validation
CUDA_VERSION=13.0
NSYS_VERSION_PREFIX=2025.1.3
