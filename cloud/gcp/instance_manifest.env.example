# Copy to an untracked file on the GCP VM. Never commit secrets.
PROJECT_ROOT=/mnt/eic-work/source/agentic-workload-simulator
WORK_ROOT=/mnt/eic-work
CACHE_ROOT=/mnt/eic-work/cache
GCP_PROJECT=project-3d59272d-3213-4e06-97b
GCP_ZONE=us-central1-a
GCP_INSTANCE_NAME=agentic-h100-spot
EIC_GCS_URI=

# The machine type supplies one H100 80GB and 750 GiB local SSD.
GCP_MACHINE_TYPE=a3-highgpu-1g
GCP_PROVISIONING_MODEL=SPOT

# Reuse the reviewed, pinned workload contract.
VLLM_PORT=8000
VLLM_TMUX_SESSION=vllm-agentic
VLLM_GPU_LOCK_DIR=/mnt/eic-work/locks/gpu-0.lock
VLLM_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
VLLM_MODEL_REVISION=b2cff646eb4bb1d68355c01b18ae02e7cf42d120
VLLM_IMAGE=vllm/vllm-openai:v0.10.0@sha256:05a31dc4185b042e91f4d2183689ac8a87bd845713d5c3f987563c5899878271
VLLM_IMAGE_PLATFORM=linux/amd64
VLLM_VERSION=0.10.0
VLLM_TOOL_PARSER=qwen3_coder
VLLM_MAX_MODEL_LEN=32768
VLLM_HEALTH_CONTEXT=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_API_KEY=local-only-placeholder
EIC_MODEL_API_BASE=http://127.0.0.1:8000/v1

PYTHON_VERSION=3.11
PYTHON_ENV_MODE=venv
PYTHON_ENV_ROOT=/mnt/eic-work/venv
PYTHON_LOCK_PATH=/mnt/eic-work/source/agentic-workload-simulator/cloud/lambda/requirements-linux-x86_64.txt
PYTHON_LOCK_SHA256=7e1177bf4c0b4efe4d64895f39b340413336b77e02d2f72bbf5aad387accc9cc

TASK_ID=GCP-H100-pilot
EXPERIMENT_ID=
SWE_AGENT_REVISION=0f3acafacabc0def8cc76b4e48acb4b6cf302cb9
SWE_BENCH_REVISION=726c5461e2ef52d83cf1ea2107870a8bb3328d57
FIRST_LITE_INSTANCE_ID=astropy__astropy-12907
LITE_DATASET_PATH=/mnt/eic-work/datasets/lite_astropy__astropy-12907.json
LITE_DATASET_SHA256=f46f2e3f003f2552932393da4b223e1e0456a2c71eba8b73ae58f29646c1278b
LITE_FIRST_DATASET_SHA256=e117000983a3aabba8f43fb52e155d0cc6529b900ed476f59dc6cc065e970faa
DATASET_MANIFEST_PATH=/mnt/eic-work/artifacts/manifests/datasets.json
SWE_BENCH_EVALUATOR_ROOT=/mnt/eic-work/repos/SWE-bench
EVALUATOR_PYTHON=/mnt/eic-work/venv/bin/python
SWE_BENCH_MAX_WORKERS=1
SWE_BENCH_TIMEOUT_SECONDS=1800
FIRST_EXPERIMENT_TIMEOUT_SECONDS=2700
EVALUATOR_IMAGE_NAMESPACE=swebench
EVALUATOR_PLATFORM=linux/amd64
VLLM_METRICS_URL=http://127.0.0.1:8000/metrics
TELEMETRY_INTERVAL_SECONDS=1
OBSERVABILITY_SCHEMA_VERSION=obs-1
EXPERIMENT_MAX_CALLS=30
EXPERIMENT_MAX_OUTPUT_TOKENS=2048
EXPERIMENT_MAX_OBSERVATION_LENGTH=100000
EXPERIMENT_TEMPERATURE=0.0
EXPERIMENT_SEED=0

SWE_AGENT_REQUEST_CONFIG=/mnt/eic-work/source/agentic-workload-simulator/cloud/lambda/sweagent_request.yaml
SWE_AGENT_COMMAND=/mnt/eic-work/venv/bin/sweagent run-batch --config /mnt/eic-work/repos/SWE-agent/config/default.yaml --config /mnt/eic-work/source/agentic-workload-simulator/cloud/lambda/sweagent_request.yaml --instances.type file --instances.path /mnt/eic-work/datasets/lite_astropy__astropy-12907.json --instances.filter '^astropy__astropy-12907$' --agent.model.name openai/Qwen/Qwen3-Coder-30B-A3B-Instruct --agent.model.api_base http://127.0.0.1:8000/v1 --agent.model.api_key "$VLLM_API_KEY" --agent.model.total_cost_limit 0 --agent.model.per_instance_cost_limit 0 --agent.model.per_instance_call_limit 30 --agent.model.temperature 0.0 --agent.model.max_input_tokens 32768 --agent.model.max_output_tokens 2048 --agent.templates.max_observation_length 100000 --output_dir /mnt/eic-work/experiments/gcp-h100-pilot --num_workers 1
SWE_AGENT_TELEMETRY_COMMAND=/mnt/eic-work/venv/bin/sweagent run-batch --config /mnt/eic-work/repos/SWE-agent/config/default.yaml --config /mnt/eic-work/source/agentic-workload-simulator/cloud/lambda/sweagent_request.yaml --instances.type file --instances.path /mnt/eic-work/datasets/lite_astropy__astropy-12907.json --instances.filter '^astropy__astropy-12907$' --agent.model.name openai/Qwen/Qwen3-Coder-30B-A3B-Instruct --agent.model.api_base http://127.0.0.1:8000/v1 --agent.model.api_key "$VLLM_API_KEY" --agent.model.total_cost_limit 0 --agent.model.per_instance_cost_limit 0 --agent.model.per_instance_call_limit 30 --agent.model.temperature 0.0 --agent.model.max_input_tokens 32768 --agent.model.max_output_tokens 2048 --agent.templates.max_observation_length 100000 --output_dir /mnt/eic-work/experiments/gcp-h100-pilot --num_workers 1
PREDICTION_PATH=/mnt/eic-work/experiments/gcp-h100-pilot/preds.json
SWE_AGENT_OUTPUT_DIR=/mnt/eic-work/experiments/gcp-h100-pilot
EVALUATOR_REPORT_DIR=/mnt/eic-work/artifacts/gcp-h100-pilot/evaluation
EVALUATE_COMMAND=/mnt/eic-work/venv/bin/python -m swebench.harness.run_evaluation --dataset_name /mnt/eic-work/datasets/lite_astropy__astropy-12907.json --split test --predictions_path /mnt/eic-work/experiments/gcp-h100-pilot/preds.json --instance_ids astropy__astropy-12907 --max_workers 1 --timeout 1800 --cache_level instance --clean False --run_id gcp-h100-pilot --namespace swebench --instance_image_tag latest --env_image_tag latest --report_dir /mnt/eic-work/artifacts/gcp-h100-pilot/evaluation
