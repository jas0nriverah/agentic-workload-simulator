# These are the exact first-run command contracts.  The command is identical
# for control and thin-telemetry modes; thin telemetry observes the running
# process without changing requests or prompts. The dict-valued
# completion_kwargs fields come from the second, pinned YAML fragment because
# SWE-agent v1.1.0 rejects nested completion_kwargs.* CLI flags.
SWE_AGENT_COMMAND=/home/ubuntu/agentic-work/venv/bin/sweagent run-batch --config /home/ubuntu/agentic-work/repos/SWE-agent/config/default.yaml --config /home/ubuntu/agentic-workload-simulator/cloud/lambda/sweagent_request.yaml --instances.type file --instances.path /home/ubuntu/agentic-work/datasets/lite_astropy__astropy-12907.json --instances.filter '^astropy__astropy-12907$' --agent.model.name openai/Qwen/Qwen3-Coder-30B-A3B-Instruct --agent.model.api_base http://127.0.0.1:8000/v1 --agent.model.api_key "$VLLM_API_KEY" --agent.model.total_cost_limit 0 --agent.model.per_instance_cost_limit 0 --agent.model.per_instance_call_limit 30 --agent.model.temperature 0.0 --agent.model.max_input_tokens 32768 --agent.model.max_output_tokens 2048 --agent.templates.max_observation_length 100000 --output_dir /home/ubuntu/agentic-work/experiments/first-lite-astropy__astropy-12907 --num_workers 1
SWE_AGENT_TELEMETRY_COMMAND=/home/ubuntu/agentic-work/venv/bin/sweagent run-batch --config /home/ubuntu/agentic-work/repos/SWE-agent/config/default.yaml --config /home/ubuntu/agentic-workload-simulator/cloud/lambda/sweagent_request.yaml --instances.type file --instances.path /home/ubuntu/agentic-work/datasets/lite_astropy__astropy-12907.json --instances.filter '^astropy__astropy-12907$' --agent.model.name openai/Qwen/Qwen3-Coder-30B-A3B-Instruct --agent.model.api_base http://127.0.0.1:8000/v1 --agent.model.api_key "$VLLM_API_KEY" --agent.model.total_cost_limit 0 --agent.model.per_instance_cost_limit 0 --agent.model.per_instance_call_limit 30 --agent.model.temperature 0.0 --agent.model.max_input_tokens 32768 --agent.model.max_output_tokens 2048 --agent.templates.max_observation_length 100000 --output_dir /home/ubuntu/agentic-work/experiments/first-lite-astropy__astropy-12907 --num_workers 1
