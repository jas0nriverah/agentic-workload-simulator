            +        ("! comment", "comment"),                                  
            +    ]                                                              
            +                                                                   
            +    print("=== Testing OLD pattern (no IGNORECASE) ===")           
            +    old_results = []                                               
            +    for line, expected_type in test_cases:                         
            +        line = line.strip()                                        
