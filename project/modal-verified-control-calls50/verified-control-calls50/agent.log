            +        ("READ TERR 1", "command"),                                
            +        ("read terr 1", "command"),  # This should work but        
            currently doesn't                                                   
            +        ("53000.5   0.25  -0.5", "data,3"),                        
            +        ("NO NO NO", "new"),                                       
            +        ("", "comment"),                                           
            +        ("! comment", "comment"),                                  
            +    ]                                                              
            +                                                                   
            +    print("Testing current regex pattern:")                        
            +    for line, expected_type in test_cases:                         
            +        line = line.strip()                                        
            +        if not line:                                               
            +            result = "comment"                                     
            +        else:                                                      
            +            match = _line_type_re.match(line)                      
            +            if match is None:                                      
            +                result = "UNRECOGNIZED"                            
            +            else:                                                  
            +                for type_, val in match.groupdict().items():       
            +                    if val is None:                                
            +                        continue                                   
