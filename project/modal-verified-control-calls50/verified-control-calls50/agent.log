            +    # This is the problematic regex from the current implementation
            +    _decimal_re = r"[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?"       
            +    _command_re = r"READ [TS]ERR(\s+[0-9]+)+"                      
            +                                                                   
            +    # Create the full regex pattern                                
            +    _new_re = rf"NO(\s+NO)+"                                       
            +    _data_re =                                                     
            rf"({_decimal_re}|NO|[-+]?nan)(\s+({_decimal_re}|NO|[-+]?nan))*"    
            +    _type_re =                                                     
            rf"^\s*((?P<command>{_command_re})|(?P<new>{_new_re})|(?P<data>{_dat
