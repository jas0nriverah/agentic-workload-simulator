            +        print(f"'{line}' -> Expected: {expected_type}, Got:        
            {result}")                                                          
            +                                                                   
            +    print("\n=== Testing NEW pattern (with IGNORECASE) ===")       
            +    new_results = []                                               
            +    for line, expected_type in test_cases:                         
