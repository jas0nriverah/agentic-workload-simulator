            +def test_line_type_function():                                     
            +    """Test the _line_type function directly."""                   
            +    try:                                                           
            +        from astropy.io.ascii.qdp import _line_type                
            +                                                                   
            +        test_cases = [                                             
            +            ("READ SERR 3", "command"),                            
            +            ("read serr 3", "command"),  # This should now work    
            +            ("READ TERR 1", "command"),                            
            +            ("read terr 1", "command"),  # This should now work    
            +            ("53000.5   0.25  -0.5", "data,3"),                    
            +            ("NO NO NO", "new"),                                   
            +            ("", "comment"),                                       
            +            ("! comment", "comment"),                              
            +        ]                                                          
            +                                                                   
            +        print("Testing _line_type function after fix:")            
            +        all_passed = True                                          
            +        for line, expected_type in test_cases:                     
            +            try:                                                   
            +                result = _line_type(line)                          
            +                if result == expected_type:                        
            +                    print(f"✓ '{line}' -> {result}")               
            +                else:                                              
            +                    print(f"✗ '{line}' -> Expected:                
            {expected_type}, Got: {result}")                                    
            +                    all_passed = False                             
            +            except Exception as e:                                 
            +                print(f"✗ '{line}' -> ERROR: {e}")                 
            +                all_passed = False                                 
            +                                                                   
            +        return all_passed                                          
            +                                                                   
            +    except ImportError as e:                                       
            +        print(f"Failed to import _line_type: {e}")                 
            +        return False                                               
            +                                                                   
            +def test_full_qdp_reading():                                       
            +    """Test reading a complete QDP file with lowercase commands."""
            +    try:                                                           
