            +#!/usr/bin/env python                                              
            +"""                                                                
            +Test script to verify QDP case sensitivity issue and fix.          
            +"""                                                                
            +                                                                   
            +import tempfile                                                    
            +import os                                                          
            +from astropy.io import ascii                                       
            +                                                                   
            +def test_case_sensitivity():                                       
            +    # Create a sample QDP file with lowercase "no" values          
            +    qdp_content = """! Initial comment line 1                      
            +! Initial comment line 2                                           
            +READ TERR 1                                                        
            +READ SERR 3                                                        
            +! Table 0 comment                                                  
            +!a a(pos) a(neg) b be c d                                          
            +53000.5   0.25  -0.5   1  1.5  3.5 2                               
            +54000.5   1.25  -1.5   2  2.5  4.5 3                               
            +no no no no no                                                     
            +! Table 1 comment                                                  
            +!a a(pos) a(neg) b be c d                                          
            +54000.5   2.25  -2.5   no  3.5  5.5 5                              
            +55000.5   3.25  -3.5   4  4.5  6.5 nan                             
            +"""                                                                
            +                                                                   
