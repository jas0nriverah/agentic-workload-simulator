h different cases."""\n    \n    # Test case 1: Lowercase commands\n    qdp_content_lower = """\n    ! Initial comment line 1\n    ! Initial comment line 2\n    read terr 1\n    read serr 3\n    ! Table 0 comment\n    !a a(pos) a(neg) b c ce d\n    53000.5   0.25  -0.5   1  1.5  3.5 2\n    54000.5   1.25  -1.5   2  2.5  4.5 3\n    NO NO NO NO NO\n    ! Table 1 comment\n    !a a(pos) a(neg) b c ce d\n    54000.5   2.25  -2.5   NO  3.5  5.5 5\n    55000.5   3.25  -3.5   4  4.5  6.5 nan\n    """\n    \n    # Test case 2: Mixed case commands  \n    qdp_content_mixed = """\n    ! Initial comment line 1\n    ! Initial comment line 2\n    Read Terr 1\n    Read Serr 3\n    ! Table 0 comment\n    !a a(pos) a(neg) b c ce d\n    53000.5   0.25  -0.5   1  1.5  3.5 2\n    54000.5   1.25  -1.5   2  2.5  4.5 3\n    NO NO NO NO NO\n    ! Table 1 comment\n    !a a(pos) a(neg) b c ce d\n    54000.5   2.25  -2.5   NO  3.5  5.5 5\n    55000.5   3.25  -3.5   4  4.5  6.5 nan\n    """\n    \n    # Test case 3: Lowercase NO values\n    qdp_content_no_lower = """\n    ! Initial comment line 1\n    ! Initial comment line 2\n    READ TERR 1\n    READ SERR 3\n    ! Table 0 comment\n    !a a(pos) a(neg) b c ce d\n    53000.5   0.25  -0.5   1  1.5  3.5 2\n    54000.5   1.25  -1.5   2  2.5  4.5 3\n    no no no no no\n    ! Table 1 comment\n    !a a(pos) a(neg) b c ce d\n    54000.5   2.25  -2.5   no  3.5  5.5 5\n    55000.5   3.25  -3.5   4  4.5  6.5 nan\n    """\n    \n    print("Testing case-insensitive QDP commands...")\n    \n    # Test 1: Lowercase commands\n    try:\n        print("Test 1: Lowercase commands")\n        t1 = ascii.read(qdp_content_lower, format="qdp", table_id=1, names=["a", "b", "c", "d"])\n        print("SUCCESS: Lowercase commands work")\n        print(f"Result shape: {t1.shape}")\n        print(f"Column names: {t1.colnames}")\n    except Exception as e:\n        print(f"FAILED: Lowercase commands failed with error: {e}")\n    \n    # Test 2: Mixed case commands\n    try: