            +#!/usr/bin/env python                                              
            +"""                                                                
            +Verify that our case-insensitive fixes work correctly              
            +"""                                                                
            +                                                                   
            +# Since we can't easily import the full astropy modules, let's     
            manually test                                                       
            +# the key regex patterns we changed                                
            +                                                                   
            +import re                                                          
            +                                                                   
            +def test_regex_patterns():                                         
            +    """Test the updated regex patterns"""                          
            +                                                                   
            +    print("Testing updated regex patterns...")                     
            +                                                                   
            +    # Test the command regex pattern                               
            +    _decimal_re = r"[+-]?(\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?"       
            +    _command_re = r"[Rr][Ee][Aa][Dd]                               
            [SsTt][Ee][Rr][Rr](\s+[0-9]+)+"                                     
            +    _new_re = r"[Nn][Oo]([Nn][Oo])+"                               
            +    _data_re =                                                     
            rf"({_decimal_re}|[Nn][Oo]|[-+]?nan)({r'\s+'}({_decimal_re}|[Nn][Oo]
            |[-+]?nan))*)"                                                      
            +    _type_re =                                                     
            rf"^\s*((?P<command>{_command_re})|(?P<new>{_new_re})|(?P<data>{_dat
            a_re})?\s*(\!(?P<comment>.*))?\s*$"                                 
            +                                                                   
            +    print(f"Command regex: {_command_re}")                         
            +    print(f"New regex: {_new_re}")                                 
            +    print(f"Data regex: {_data_re}")                               
            +    print(f"Full regex: {_type_re}")                               
            +                                                                   
            +    # Test patterns against various inputs                         
            +    test_cases = [                                                 
            +        # Commands                                                 
            +        ("READ TERR 1", "command"),                                
            +        ("read terr 1", "command"),                                
            +        ("Read Terr 1", "command"),                                
            +        ("READ SERR 3", "command"),                                
            +        ("read serr 3", "command"),                                
            +        ("Read Serr 3", "command"),                                
            +        ("rEAd sErR 2", "command"),                                
            +                                                                   
            +        # New lines (should detect as "new")                       
            +        ("NO NO NO", "new"),                                       
            +        ("no no no", "new"),                                       
            +        ("No No No", "new"),                                       
            +        ("nO nO nO", "new"),                                       
            +                                                                   
            +        # Data lines                                               
            +        ("21345.45", "data,1"),                                    
            +        ("21345.45 1.53e-3 1e-3 .04 NO nan", "data,6"),            
            +        ("21345.45 1.53e-3 1e-3 .04 no nan", "data,6"),            
            +        ("21345.45 1.53e-3 1e-3 .04 No nan", "data,6"),            
            +    ]                                                              
            +                                                                   
            +    compiled_re = re.compile(_type_re)                             
            +                                                                   
            +    for line, expected_type in test_cases:                         
            +        stripped_line = line.strip()                               
            +        match = compiled_re.match(stripped_line)                   
            +        if match:                                                  
            +            # Determine the type from the matched groups           
            +            for group_name, value in match.groupdict().items():    
            +                if value is not None:                              
            +                    if group_name == "data":                       
            +                        result = f"data,{len(value.split())}"      
            +                    else:                                          
            +                        result = group_name                        
            +                    break                                          
            +            else:                                                  
            +                result = "unknown"                                 
            +        else:                                                      
            +            result = "unrecognized"                                
            +                                                                   
            +        if result == expected_type:                                
            +            print(f"✓ '{line}' -> {result}")                       
            +        else:                                                      
            +            print(f"✗ '{line}' -> {result} (expected               
            {expected_type})")                                                  
            +                                                                   
            +if __name__ == "__main__":                                         
            +    test_regex_patterns()                                          
            \ No newline at end of file                                         
                                                                                
