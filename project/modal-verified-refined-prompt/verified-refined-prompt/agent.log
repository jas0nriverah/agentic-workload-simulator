            +#!/usr/bin/env python                                              
            +"""                                                                
            +Simple test to check the _line_type function directly              
            +"""                                                                
            +                                                                   
            +import sys                                                         
            +sys.path.insert(0, '/testbed')                                     
            +                                                                   
            +from astropy.io.ascii.qdp import _line_type                        
            +                                                                   
            +def test_line_type():                                              
            +    """Test the _line_type function with different cases."""       
            +                                                                   
            +    print("Testing _line_type function...")                        
            +                                                                   
            +    # Test cases that should work                                  
            +    test_cases = [                                                 
            +        ("READ TERR 1", "command"),                                
            +        ("read terr 1", "command"),  # lowercase                   
            +        ("Read Terr 1", "command"),  # mixed case                  
            +        ("READ SERR 3", "command"),                                
            +        ("read serr 3", "command"),  # lowercase                   
            +        ("NO NO NO NO NO", "new"),   # should work                 
            +        ("no no no no no", "new"),   # lowercase should work       
            +        ("No No No No No", "new"),   # mixed case should work      
            +        (" 21345.45", "data,1"),     # regular data                
            +        (" 21345.45 1.53e-3 1e-3 .04 NO nan", "data,6"),  # data   
            with NO                                                             
            +        (" 21345.45 1.53e-3 1e-3 .04 no nan", "data,6"),  # data   
            with lowercase no                                                   
            +    ]                                                              
            +                                                                   
            +    for line, expected in test_cases:                              
            +        try:                                                       
            +            result = _line_type(line)                              
            +            if result == expected:                                 
            +                print(f"✓ '{line}' -> {result}")                   
            +            else:                                                  
            +                print(f"✗ '{line}' -> {result} (expected           
            {expected})")                                                       
            +        except Exception as e:                                     
            +            print(f"✗ '{line}' -> ERROR: {e}")                     
            +                                                                   
            +if __name__ == "__main__":                                         
            +    test_line_type()                                               
