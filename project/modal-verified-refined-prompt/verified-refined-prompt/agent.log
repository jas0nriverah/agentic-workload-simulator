            +import os                                                          
            +from astropy.io import ascii                                       
            +from astropy.table import Table                                    
            +                                                                   
            +def test_case_insensitive_commands():                              
            +    """Test that QDP commands work with different cases."""        
            +                                                                   
            +    # Test case 1: Lowercase commands                              
            +    qdp_content_lower = """                                        
            +    ! Initial comment line 1                                       
            +    ! Initial comment line 2                                       
            +    read terr 1                                                    
            +    read serr 3                                                    
            +    ! Table 0 comment                                              
            +    !a a(pos) a(neg) b c ce d                                      
            +    53000.5   0.25  -0.5   1  1.5  3.5 2                           
            +    54000.5   1.25  -1.5   2  2.5  4.5 3                           
            +    NO NO NO NO NO                                                 
            +    ! Table 1 comment                                              
            +    !a a(pos) a(neg) b c ce d                                      
            +    54000.5   2.25  -2.5   NO  3.5  5.5 5                          
            +    55000.5   3.25  -3.5   4  4.5  6.5 nan                         
            +    """                                                            
            +                                                                   
            +    # Test case 2: Mixed case commands                             
            +    qdp_content_mixed = """                                        
            +    ! Initial comment line 1                                       
            +    ! Initial comment line 2                                       
            +    Read Terr 1                                                    
            +    Read Serr 3                                                    
            +    ! Table 0 comment                                              
            +    !a a(pos) a(neg) b c ce d                                      
            +    53000.5   0.25  -0.5   1  1.5  3.5 2                           
            +    54000.5   1.25  -1.5   2  2.5  4.5 3                           
            +    NO NO NO NO NO                                                 
            +    ! Table 1 comment                                              
            +    !a a(pos) a(neg) b c ce d                                      
            +    54000.5   2.25  -2.5   NO  3.5  5.5 5                          
            +    55000.5   3.25  -3.5   4  4.5  6.5 nan                         
            +    """                                                            
            +                                                                   
            +    # Test case 3: Lowercase NO values                             
            +    qdp_content_no_lower = """                                     
            +    ! Initial comment line 1                                       
            +    ! Initial comment line 2                                       
            +    READ TERR 1                                                    
            +    READ SERR 3                                                    
            +    ! Table 0 comment                                              
            +    !a a(pos) a(neg) b c ce d                                      
            +    53000.5   0.25  -0.5   1  1.5  3.5 2                           
            +    54000.5   1.25  -1.5   2  2.5  4.5 3                           
            +    no no no no no                                                 
            +    ! Table 1 comment                                              
            +    !a a(pos) a(neg) b c ce d                                      
            +    54000.5   2.25  -2.5   no  3.5  5.5 5                          
            +    55000.5   3.25  -3.5   4  4.5  6.5 nan                         
            +    """                                                            
            +                                                                   
            +    print("Testing case-insensitive QDP commands...")              
            +                                                                   
            +    # Test 1: Lowercase commands                                   
            +    try:                                                           
            +        print("Test 1: Lowercase commands")                        
            +        t1 = ascii.read(qdp_content_lower, format="qdp",           
            table_id=1, names=["a", "b", "c", "d"])                             
            +        print("SUCCESS: Lowercase commands work")                  
            +        print(f"Result shape: {t1.shape}")                         
            +        print(f"Column names: {t1.colnames}")                      
            +    except Exception as e:                                         
            +        print(f"FAILED: Lowercase commands failed with error: {e}")
            +                                                                   
            +    # Test 2: Mixed case commands                                  
            +    try:                                                           
            +        print("\nTest 2: Mixed case commands")                     
            +        t2 = ascii.read(qdp_content_mixed, format="qdp",           
            table_id=1, names=["a", "b", "c", "d"])                             
            +        print("SUCCESS: Mixed case commands work")                 
            +        print(f"Result shape: {t2.shape}")                         
            +        print(f"Column names: {t2.colnames}")                      
            +    except Exception as e:                                         
            +        print(f"FAILED: Mixed case commands failed with error:     
            {e}")                                                               
            +                                                                   
            +    # Test 3: Lowercase NO values                                  
            +    try:                                                           
            +        print("\nTest 3: Lowercase NO values")                     
            +        t3 = ascii.read(qdp_content_no_lower, format="qdp",        
            table_id=1, names=["a", "b", "c", "d"])                             
            +        print("SUCCESS: Lowercase NO values work")                 
            +        print(f"Result shape: {t3.shape}")                         
            +        print(f"Column names: {t3.colnames}")                      
            +        print(f"Masked values in b column: {t3['b'].mask}")        
            +    except Exception as e:                                         
            +        print(f"FAILED: Lowercase NO values failed with error:     
            {e}")                                                               
            +                                                                   
            +if __name__ == "__main__":                                         
            +    test_case_insensitive_commands()                               
